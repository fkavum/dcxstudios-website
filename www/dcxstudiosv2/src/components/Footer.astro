---
import Icon from './Icon.astro';
---

<footer class="bg-dark-surface border-t border-white/10 pt-16 pb-8 text-white relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8 mb-16">
      <!-- Logo & Description -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        <a href="/" class="flex gap-2 items-center">
          <div class="size-10 rounded-full flex items-center justify-center text-dark-surface bg-white">
            <Icon name="cube-transparent" class="w-6 h-6" />
          </div>
          <div class="font-bold text-xl tracking-tight">DCX Studios</div>
        </a>
        <p class="text-accent-gray/60 leading-relaxed max-w-sm">
          Creating memorable digital experiences. Follow us on our journey to redefine mobile gaming.
        </p>
        <div class="flex gap-4">
          <a
            href="https://www.linkedin.com/company/dcx-studios/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-white/10 text-white/70 hover:text-white transition-all duration-200"
            aria-label="LinkedIn"
          >
            <Icon name="linkedin" class="w-5 h-5" />
          </a>
          <a
            href="https://discord.gg/vsWZqhUHA8"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-white/10 text-white/70 hover:text-white transition-all duration-200"
            aria-label="Discord"
          >
            <Icon name="discord" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Spacer -->
      <div class="hidden lg:block lg:col-span-1"></div>

      <!-- Explore Links -->
      <div class="lg:col-span-2">
        <h4 class="font-bold text-lg mb-6 text-white">Explore</h4>
        <ul class="flex flex-col gap-4">
          <li><a href="/#about" class="text-accent-gray/60 hover:text-primary transition-colors">About Us</a></li>
          <li><a href="/#our-games" class="text-accent-gray/60 hover:text-primary transition-colors">Our Games</a></li>
          <li><a href="/#contact" class="text-accent-gray/60 hover:text-primary transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="lg:col-span-2">
        <h4 class="font-bold text-lg mb-6 text-white">Legal</h4>
        <ul class="flex flex-col gap-4">
          <li><a href="/privacy-policy" class="text-accent-gray/60 hover:text-primary transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-accent-gray/60 hover:text-primary transition-colors">Terms of Service</a></li>
          <li><a href="/cookie-policy" class="text-accent-gray/60 hover:text-primary transition-colors">Cookie Policy</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="lg:col-span-3">
        <h4 class="font-bold text-lg mb-6 text-white">Get in Touch</h4>
        <p class="text-accent-gray/60 mb-2">Have a question? Email us at</p>
        <a href="mailto:dcxstudios@gmail.com" class="text-primary hover:text-white transition-colors font-medium text-lg">
          dcxstudios@gmail.com
        </a>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-accent-gray/40 text-sm">
        &copy; {new Date().getFullYear()} DCX Studios. All rights reserved.
      </p>
      <p class="text-accent-gray/40 text-xs">Made with ❤️ for gamers.</p>
    </div>
  </div>
</footer>
