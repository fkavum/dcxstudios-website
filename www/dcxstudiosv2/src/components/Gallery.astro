---
export interface GalleryItem {
  id: string;
  path: string;
  type: 'image' | 'video';
  header: string;
  description: string;
  alttext: string;
  thumbnailSeconds?: number;
  poster?: string;
  tag?: string;
}

export interface GameInfo {
  name: string;
  slug: string;
  icon: string;
  tagline: string;
  description: string;
  appStoreUrl?: string;
  googlePlayUrl?: string;
  webUrl?: string;
}

interface Props {
  items: GalleryItem[];
  sectionId?: string;
  game?: GameInfo;
}

const { items, sectionId = 'gallery-app', game } = Astro.props;
---

<section id={sectionId} class="bg-background-light w-full py-16 lg:py-24">
  <div class="container mx-auto px-6">

    <!-- Section badge -->
    <div class="text-center mb-10 lg:mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-dark-surface/5 border border-dark-surface/10 mb-2">
        <span class="text-sm font-medium text-dark-surface/60">Featured Game</span>
      </div>
    </div>

    {game && (
      <!-- Game info card -->
      <div class="flex flex-col sm:flex-row items-start gap-5 mb-12 p-6 lg:p-8 rounded-3xl bg-white border border-gray-200 shadow-sm">
        <img
          src={game.icon}
          alt={game.name + ' icon'}
          class="w-16 h-16 rounded-2xl shadow-sm shrink-0"
          loading="lazy"
        />
        <div class="flex-1 min-w-0">
          <h2 class="text-3xl lg:text-4xl font-black text-dark-surface leading-tight">{game.name}</h2>
          <p class="text-primary font-semibold text-sm mt-1 mb-3">{game.tagline}</p>
          <p class="text-dark-surface/70 text-base leading-relaxed mb-5 max-w-2xl">{game.description}</p>

          <!-- Store / web links -->
          <div class="flex flex-wrap gap-3">
            {game.appStoreUrl && (
              <a
                href={game.appStoreUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-dark-surface text-white text-sm font-semibold hover:opacity-80 transition-opacity"
              >
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516s1.52.087 2.475-1.258.762-2.391.728-2.43m3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422s1.675-2.789 1.698-2.854-.597-.79-1.254-1.157a3.7 3.7 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56s.625 1.924 1.273 2.796c.576.984 1.34 1.667 1.659 1.899s1.219.386 1.843.067c.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758q.52-1.185.473-1.282"/>
                </svg>
                App Store
              </a>
            )}
            {game.googlePlayUrl && (
              <a
                href={game.googlePlayUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-dark-surface text-white text-sm font-semibold hover:opacity-80 transition-opacity"
              >
                <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M14.222 9.374c1.037-.61 1.037-2.137 0-2.748L11.528 5.04 8.32 8l3.207 2.96zm-3.595 2.116L7.583 8.68 1.03 14.73c.201 1.029 1.36 1.61 2.303 1.055zM1 13.396V2.603L6.846 8zM1.03 1.27l6.553 6.05 3.044-2.81L3.333.215C2.39-.341 1.231.24 1.03 1.27"/>
                </svg>
                Google Play
              </a>
            )}
            {game.webUrl && (
              <a
                href={game.webUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-dark-surface/20 text-dark-surface text-sm font-semibold hover:bg-dark-surface hover:text-white transition-all"
              >
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253M3 12c0 .778.099 1.533.284 2.253"/>
                </svg>
                Game Website
              </a>
            )}
            {game.slug && (
              <a
                href={`/games/${game.slug}`}
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-primary/40 text-primary text-sm font-semibold hover:bg-primary hover:text-dark-surface transition-all"
              >
                View Details →
              </a>
            )}
          </div>
        </div>
      </div>
    )}

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_270px] items-start">
      <!-- Main Display -->
      <div class="rounded-3xl overflow-hidden bg-white border border-gray-200 shadow-lg gallery-hover-group">
        <div
          class="relative bg-gradient-to-br from-accent-gray to-gray-100 flex items-center justify-center overflow-hidden"
          style="height: min(60svh, 600px);"
        >
          <div id={`${sectionId}-main`} class="relative w-full h-full flex items-center justify-center"></div>

          <button
            id={`${sectionId}-prev`}
            class="gallery-nav-arrow absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm shadow-lg border border-gray-200 items-center justify-center hover:scale-110 transition-transform z-10"
            aria-label="Previous"
            style="display: none;"
          >
            <svg class="w-6 h-6 text-dark-surface" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <button
            id={`${sectionId}-next`}
            class="gallery-nav-arrow absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm shadow-lg border border-gray-200 items-center justify-center hover:scale-110 transition-transform z-10"
            aria-label="Next"
          >
            <svg class="w-6 h-6 text-dark-surface" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

          <div
            id={`${sectionId}-counter`}
            class="absolute top-4 right-4 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-sm text-white text-sm font-medium z-10"
          >
            1 / {items.length}
          </div>
        </div>

        <!-- Info Panel -->
        <div id={`${sectionId}-info`} class="px-6 py-5 border-t border-gray-100 min-h-[88px]"></div>
      </div>

      <!-- Thumbnails (scrollable) -->
      <div
        id={`${sectionId}-thumbs`}
        class="flex flex-row lg:flex-col gap-3 overflow-x-auto lg:overflow-x-visible overflow-y-visible lg:overflow-y-auto scrollbar-thin p-1 -m-1 pb-2 lg:pb-1"
        style="max-height: min(60svh, 600px);"
      ></div>
    </div>

    <div class="mt-6 text-center">
      <p class="text-xs text-dark-surface/40">Use arrow keys to navigate • Click thumbnails to select</p>
    </div>

  </div>
</section>

<script define:vars={{ galleryItems: items, galleryId: sectionId }}>
  (function () {
    var mainEl = document.getElementById(galleryId + '-main');
    var prevBtn = document.getElementById(galleryId + '-prev');
    var nextBtn = document.getElementById(galleryId + '-next');
    var counterEl = document.getElementById(galleryId + '-counter');
    var infoEl = document.getElementById(galleryId + '-info');
    var thumbsEl = document.getElementById(galleryId + '-thumbs');

    if (!mainEl) return;

    var selectedId = galleryItems[0].id;

    function getItem() {
      return galleryItems.find(function (i) { return i.id === selectedId; }) || galleryItems[0];
    }

    function getIndex() {
      return galleryItems.findIndex(function (i) { return i.id === selectedId; });
    }

    function renderMain() {
      var item = getItem();
      var index = getIndex();

      mainEl.innerHTML = '';

      if (item.type === 'video') {
        var video = document.createElement('video');
        video.src = item.path;
        video.className = 'w-full h-full object-contain';
        if (item.poster) video.poster = item.poster;
        video.autoplay = true;
        video.loop = true;
        video.muted = true;
        video.playsInline = true;
        mainEl.appendChild(video);
        // iOS autoplay fallback
        var p = video.play();
        if (p !== undefined) {
          p.catch(function () {
            var btn = document.createElement('button');
            btn.setAttribute('aria-label', 'Play video');
            btn.style.cssText = 'position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.25);z-index:20;cursor:pointer;border:none;width:100%;';
            btn.innerHTML = '<div style="width:64px;height:64px;border-radius:50%;background:rgba(255,255,255,0.92);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(0,0,0,0.25)"><svg width="28" height="28" fill="#181811" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div>';
            btn.addEventListener('click', function () { video.play(); btn.remove(); }, { once: true });
            mainEl.appendChild(btn);
          });
        }
      } else {
        var img = document.createElement('img');
        img.src = item.path;
        img.alt = item.alttext;
        img.className = 'w-full h-full object-contain';
        mainEl.appendChild(img);
      }

      counterEl.textContent = (index + 1) + ' / ' + galleryItems.length;
      prevBtn.style.display = index > 0 ? 'flex' : 'none';
      nextBtn.style.display = index < galleryItems.length - 1 ? 'flex' : 'none';

      renderInfo(item);
      updateThumbStates();
    }

    function renderInfo(item) {
      var tag = item.tag || (item.type === 'video' ? 'Video' : 'Screenshot');
      var isVideo = item.type === 'video';
      var iconSvg = isVideo
        ? '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-dark-surface" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.328l5.603 3.113z"/></svg>'
        : '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-dark-surface" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>';

      infoEl.innerHTML =
        '<div class="flex items-start gap-4">' +
          '<div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center shrink-0 mt-0.5">' + iconSvg + '</div>' +
          '<div class="flex-1 min-w-0">' +
            '<div class="flex items-center gap-2 mb-1">' +
              '<h3 class="font-bold text-dark-surface text-base">' + item.header + '</h3>' +
              '<span class="text-xs font-medium px-2 py-0.5 rounded-full bg-accent-gray text-dark-surface/60 shrink-0">' + tag + '</span>' +
            '</div>' +
            '<p class="text-sm text-dark-surface/60 leading-relaxed">' + item.description + '</p>' +
          '</div>' +
        '</div>';
    }

    function buildThumbs() {
      thumbsEl.innerHTML = '';
      galleryItems.forEach(function (item) {
        var btn = document.createElement('button');
        btn.dataset.thumbId = item.id;
        btn.className = 'group shrink-0 lg:w-full w-36 text-left rounded-2xl overflow-hidden bg-white border-2 shadow-md transition-all duration-300 focus:outline-none border-gray-200 hover:border-gray-300 hover:shadow-lg hover:scale-[1.02]';

        var mediaWrap = document.createElement('div');
        mediaWrap.className = 'w-full h-36 bg-gradient-to-br from-accent-gray to-gray-100 overflow-hidden flex items-center justify-center';

        var mediaEl;
        if (item.type === 'video') {
          mediaEl = document.createElement('video');
          mediaEl.src = item.path;
          mediaEl.muted = true;
          mediaEl.preload = 'metadata';
          if (item.poster) mediaEl.poster = item.poster;
          var seekTo = typeof item.thumbnailSeconds === 'number' ? item.thumbnailSeconds : 0;
          mediaEl.addEventListener('loadedmetadata', function () {
            mediaEl.currentTime = seekTo;
          });
        } else {
          mediaEl = document.createElement('img');
          mediaEl.src = item.path;
          mediaEl.alt = item.alttext;
        }
        mediaEl.className = 'w-full h-full object-contain transition-transform duration-500 group-hover:scale-105 brightness-90 group-hover:brightness-100';
        mediaWrap.appendChild(mediaEl);
        btn.appendChild(mediaWrap);

        var titleWrap = document.createElement('div');
        titleWrap.className = 'px-3 py-2.5';
        var p = document.createElement('p');
        p.className = 'text-xs font-semibold transition-colors duration-200 line-clamp-2 text-dark-surface group-hover:text-primary';
        p.textContent = item.header;
        titleWrap.appendChild(p);
        btn.appendChild(titleWrap);

        btn.addEventListener('click', function () {
          selectedId = item.id;
          renderMain();
        });

        thumbsEl.appendChild(btn);
      });
    }

    function updateThumbStates() {
      var thumbs = thumbsEl.querySelectorAll('[data-thumb-id]');
      thumbs.forEach(function (btn) {
        var isSelected = btn.dataset.thumbId === selectedId;
        if (isSelected) {
          btn.classList.add('ring-2', 'ring-primary', 'border-primary', 'scale-[1.02]');
          btn.classList.remove('border-gray-200');
          var p = btn.querySelector('p');
          if (p) { p.classList.add('text-primary'); p.classList.remove('text-dark-surface'); }
          var media = btn.querySelector('img, video');
          if (media) { media.classList.add('brightness-100'); media.classList.remove('brightness-90'); }
        } else {
          btn.classList.remove('ring-2', 'ring-primary', 'border-primary', 'scale-[1.02]');
          btn.classList.add('border-gray-200');
          var p = btn.querySelector('p');
          if (p) { p.classList.remove('text-primary'); p.classList.add('text-dark-surface'); }
          var media = btn.querySelector('img, video');
          if (media) { media.classList.remove('brightness-100'); media.classList.add('brightness-90'); }
        }
      });
    }

    prevBtn.addEventListener('click', function () {
      var index = getIndex();
      if (index > 0) { selectedId = galleryItems[index - 1].id; renderMain(); }
    });

    nextBtn.addEventListener('click', function () {
      var index = getIndex();
      if (index < galleryItems.length - 1) { selectedId = galleryItems[index + 1].id; renderMain(); }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { var i = getIndex(); if (i > 0) { selectedId = galleryItems[i - 1].id; renderMain(); } }
      if (e.key === 'ArrowRight') { var i = getIndex(); if (i < galleryItems.length - 1) { selectedId = galleryItems[i + 1].id; renderMain(); } }
    });

    buildThumbs();
    renderMain();
  })();
</script>
