---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { getGameIcon } from '../data/common';

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;
const { title, subtitle, cardImage, shortDescription } = game.data;
const icon = getGameIcon(game.id);
---

<a
  href={`/games/${game.id}`}
  class="group block rounded-3xl bg-white border border-gray-200 hover:border-primary hover:shadow-xl transition-all duration-300 hover:-translate-y-1 overflow-hidden"
>
  {cardImage && (
    <div class="w-full h-56 bg-gradient-to-br from-accent-gray to-gray-100 overflow-hidden flex items-center justify-center">
      <img
        src={cardImage}
        alt={title}
        class="h-full w-auto object-contain transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}

  <div class="p-6">
    <div class="flex items-start gap-4 mb-4">
      <img src={icon} alt={title + ' icon'} class="w-14 h-14 rounded-2xl object-cover shadow-sm shrink-0" />
      <div>
        <h3 class="text-xl font-bold text-dark-surface">{title}</h3>
        <p class="text-primary font-semibold text-sm">{subtitle}</p>
      </div>
    </div>

    <p class="text-dark-surface/70 text-sm leading-relaxed mb-5">{shortDescription}</p>

    <span class="inline-flex items-center gap-1.5 text-primary font-semibold text-sm group-hover:gap-3 transition-all duration-200">
      View Game
      <Icon name="arrow-right" class="w-4 h-4" />
    </span>
  </div>
</a>
