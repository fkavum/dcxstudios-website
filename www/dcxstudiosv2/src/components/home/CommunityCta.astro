---
import Icon from '../Icon.astro';
---

<section class="py-24 lg:py-32 bg-dark-surface relative overflow-hidden text-white">
  <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/10 rounded-full blur-[120px] translate-x-1/2 -translate-y-1/2 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary/8 rounded-full blur-[120px] -translate-x-1/2 translate-y-1/2 pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="rounded-3xl bg-white/5 border border-white/10 p-8 lg:p-16 backdrop-blur-sm shadow-2xl overflow-hidden relative">
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/50 to-transparent opacity-50"></div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 w-fit mb-6">
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span class="text-xs font-bold text-primary uppercase tracking-wider">Join the Community</span>
          </div>

          <h2 class="text-4xl lg:text-5xl font-black mb-6 tracking-tight">
            Be Part of the <span class="text-primary">Journey</span>
          </h2>

          <p class="text-lg text-white/70 mb-8 leading-relaxed max-w-md">
            We are building the next generation of puzzle games. Follow us on social media for behind-the-scenes, updates, and upcoming titles.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="https://discord.gg/vsWZqhUHA8"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-primary text-dark-surface px-8 py-4 rounded-full font-bold text-base hover:scale-105 transition-transform duration-200"
            >
              <Icon name="discord" class="w-5 h-5" />
              Join Discord
            </a>
            <a
              href="https://www.linkedin.com/company/dcx-studios/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 border border-white text-white px-8 py-4 rounded-full font-bold text-base hover:bg-white/10 transition-all duration-200"
            >
              <Icon name="linkedin" class="w-5 h-5" />
              Follow on LinkedIn
            </a>
          </div>
        </div>

        <div class="relative lg:h-full min-h-[300px] flex items-center justify-center">
          <div class="flex flex-col items-center gap-6 text-center">
            <div class="w-24 h-24 bg-[#5865F2]/20 rounded-3xl flex items-center justify-center border border-[#5865F2]/30 shadow-2xl shadow-[#5865F2]/10">
              <Icon name="discord" class="w-12 h-12 text-[#5865F2]" />
            </div>
            <div>
              <div id="cta-member-count" class="text-5xl font-black text-white">—</div>
              <p class="text-white/50 text-sm mt-1 uppercase tracking-wider font-medium">Members & Growing</p>
            </div>
            <div class="flex items-center gap-8">
              <div>
                <div id="cta-online-count" class="text-2xl font-bold text-primary">—</div>
                <p class="text-white/40 text-xs mt-0.5">Online Now</p>
              </div>
              <div class="w-px h-10 bg-white/10"></div>
              <div>
                <div class="text-2xl font-bold text-primary">Free</div>
                <p class="text-white/40 text-xs mt-0.5">To Join</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  fetch('https://discord.com/api/invites/vsWZqhUHA8?with_counts=true')
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var memberEl = document.getElementById('cta-member-count');
      var onlineEl = document.getElementById('cta-online-count');
      if (memberEl && data.approximate_member_count) {
        var total = data.approximate_member_count;
        memberEl.textContent = total >= 1000 ? (total / 1000).toFixed(1) + 'k' : String(total);
      }
      if (onlineEl && data.approximate_presence_count) {
        var online = data.approximate_presence_count;
        onlineEl.textContent = online >= 1000 ? (online / 1000).toFixed(1) + 'k' : String(online);
      }
    })
    .catch(function () {});
</script>
