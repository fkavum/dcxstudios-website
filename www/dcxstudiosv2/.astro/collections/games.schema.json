{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "cardImage": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appStoreUrl": {
      "type": "string"
    },
    "googlePlayUrl": {
      "type": "string"
    },
    "hasGame": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "subtitle",
    "shortDescription",
    "features"
  ]
}