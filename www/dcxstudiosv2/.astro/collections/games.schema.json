{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "cardImage": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "appStoreUrl": {
      "type": "string"
    },
    "googlePlayUrl": {
      "type": "string"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "src": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          }
        },
        "required": [
          "id",
          "src",
          "alt",
          "title",
          "description",
          "tag",
          "type"
        ]
      }
    },
    "hasGame": {
      "default": false,
      "type": "boolean"
    },
    "order": {
      "default": 0,
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "subtitle",
    "icon",
    "shortDescription",
    "features",
    "gallery"
  ]
}