---
const screenshots = [
  { src: '/images/crossle-home-screen.webp', alt: 'Crossle home screen' },
  { src: '/images/crossle-gameplay.webp', alt: 'Crossle live PvP duel gameplay' },
  { src: '/images/crossle-leaderboard.webp', alt: 'Crossle global leaderboard' },
] as const;
---

<section class="py-24">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4 text-white">Game Screenshots</h2>
      <p class="text-slate-400">A closer look at the action.</p>
    </div>

    <div class="flex gap-6 overflow-x-auto pb-4 snap-x snap-mandatory scrollbar-hide justify-start lg:justify-center">
      {screenshots.map(shot => (
        <div class="shrink-0 snap-center w-[220px]">
          <img
            src={shot.src}
            alt={shot.alt}
            width="220"
            height="440"
            loading="lazy"
            class="w-full h-auto rounded-[2rem] shadow-2xl border-4 border-white/10"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
