---
---

<section class="relative pt-20 pb-20 lg:pt-32 lg:pb-32 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-indigo-900/20 via-transparent to-transparent pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">

      <!-- Text -->
      <div class="flex-1 text-center lg:text-left">
        <h1 class="text-5xl lg:text-7xl font-black tracking-tight mb-6 leading-none">
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-yellow-400 to-orange-500">Crossle</span>
          <span class="block text-4xl lg:text-5xl text-white mt-3">Online Word Duel</span>
        </h1>

        <p class="text-xl text-slate-300 mb-10 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          The ultimate multiplayer word game. Compete in crossword-style duels, use strategy to outsmart your opponents, and climb the global ranks.
        </p>

        <div class="flex flex-wrap justify-center lg:justify-start gap-4">
          <a
            href="https://apps.apple.com/tr/app/crossle-online-word-duel/id6751605835"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-white text-slate-900 px-6 py-3 rounded-xl h-[60px] min-w-[180px] font-bold shadow-xl hover:scale-105 transition-transform duration-200"
          >
            <svg class="w-8 h-8 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98l-.09.06c-.22.14-2.19 1.28-2.17 3.81.03 3.02 2.65 4.03 2.68 4.04l-.06.27zM13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            <div class="flex flex-col items-start leading-none">
              <span class="text-[10px] uppercase font-medium opacity-60">Download on the</span>
              <span class="text-xl font-bold">App Store</span>
            </div>
          </a>

          <a
            href="https://play.google.com/store/apps/details?id=com.dcxstudios.dcm"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 bg-white text-slate-900 px-6 py-3 rounded-xl h-[60px] min-w-[180px] font-bold shadow-xl hover:scale-105 transition-transform duration-200"
          >
            <svg class="w-7 h-7 shrink-0 ml-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.18 23.76c.3.17.64.24.99.2l.1-.03L13.64 14 10 10.37 3.18 23.76zm17.15-11.26-3.08-1.76-3.9 3.9 3.89 3.89 3.09-1.77a1.75 1.75 0 0 0 0-4.26zM2.1.38A1.74 1.74 0 0 0 1.75 1.2v21.6c0 .3.08.59.23.84L13.61 12 2.1.38zm11.53 11.38L4.27.38C3.92.34 3.57.41 3.27.58l10.83 10.84L13.63 11.76z"/></svg>
            <div class="flex flex-col items-start leading-none ml-0.5">
              <span class="text-[10px] uppercase font-medium opacity-60">GET IT ON</span>
              <span class="text-xl font-bold">Google Play</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="flex-1 w-full flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[240px] lg:max-w-[300px]">
          <div class="absolute inset-0 bg-yellow-400/20 blur-3xl rounded-full scale-110"></div>
          <img
            src="/images/hero-mockup.png"
            alt="Crossle multiplayer word duel game screenshot showing PvP crossword gameplay"
            width="300"
            height="600"
            loading="eager"
            class="relative z-10 w-full h-auto rounded-[2.5rem] shadow-2xl border-4 border-white/10 rotate-3 hover:rotate-0 transition-transform duration-500"
          />
        </div>
      </div>

    </div>
  </div>
</section>
